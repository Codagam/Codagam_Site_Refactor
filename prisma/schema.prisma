generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}




model HeroSection {
  id         String   @id @default("hero") @map("_id")
  title      String
  imageUrl   String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([position])
  @@map("hero_section")
}

model Product {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  headline           String
  description        String
  details            String   @default("")
  imageUrl           String
  website            String
  backgroundImageUrl String?
  position           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([position])
  @@map("products")
}

model ClientLogo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  logoUrl   String
  alt       String?  // Optional alt text
  width     Int      @default(160)
  height    Int      @default(100)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("client_logos")
}

model TechStackCategory {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  position    Int                 @default(0)
  capabilities TechStackCapability[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([position])
  @@map("tech_stack_categories")
}

model TechStackCapability {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  text       String
  image      String?
  icon       String?
  alt        String
  categoryId String            @db.ObjectId
  category   TechStackCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  position   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([categoryId, position])
  @@index([position])
  @@map("tech_stack_capabilities")
}

model FooterContent {
  id          String   @id @default("footer_content") @map("_id")
  title       String   // Footer header title
  description String   // Footer header description
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("footer_content")
} 
model FooterOffice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  country       String   // Country name (e.g., "India", "USA")
  countryCode   String? // ISO country code (e.g., "IN", "US") for flag icons
  countryPosition Int    @default(0) // Position for country grouping
  flagUrl       String?  // Country flag URL (deprecated, use countryCode instead)
  address       String
  phone         String?
  email         String?
  position      Int      @default(0) // Position within the country
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([country, position])
  @@index([countryPosition])
  @@map("footer_offices")
}

model FooterSocialLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String   // Platform name used to get icon component from database (e.g., "instagram", "facebook", "twitter", "linkedin", "youtube", "github", "whatsapp", "telegram")
  url       String   // Social media profile URL
  iconType  String   @default("") // Reserved for future custom icon types
  position  Int      @default(0) // Display order (lower numbers appear first)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("footer_social_links")
}
